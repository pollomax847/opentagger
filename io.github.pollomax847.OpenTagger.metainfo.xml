<component type="desktop-application">
  <id>io.github.pollomax847.OpenTagger</id>
  <name>OpenTagger</name>
  <summary>Tagueur audio automatique open-source</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.pollomax847">
    <name>pollomax847</name>
  </developer>
  <description>
    <p>
      OpenTagger identifie et complète automatiquement les métadonnées de vos fichiers audio
      (MP3, FLAC, M4A, OGG) via une chaîne de reconnaissance audio (AcoustID, SongRec, AudD),
      enrichie par MusicBrainz, Discogs et Last.fm — une alternative libre à Jaikoz.
    </p>
    <p>Fonctionnalités principales :</p>
    <ul>
      <li>Identification par empreinte audio et renommage par masques configurables</li>
      <li>Détection de doublons et complétion automatique des albums incomplets</li>
      <li>Taguage de podcasts via flux RSS</li>
      <li>Transcodage audio et scripts de correction personnalisés</li>
    </ul>
  </description>
  <!-- opentagger-OpenTagger.desktop : nom généré par jpackage (pas rDNS), volontairement laissé
       tel quel — AppStream n'exige pas que <id> corresponde au nom du .desktop dès qu'un
       <launchable> explicite est fourni. -->
